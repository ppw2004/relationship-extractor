# 智谱 AI 配置
# 获取 API Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# 使用的模型名称
# 可选值: glm-4.5, glm-4.5-air, glm-4.6, glm-4.7, glm-5, glm-5-turbo, glm-5.1
# 推荐: glm-4.5-air (性价比高), glm-5.1 (最新最强)
ZHIPU_MODEL=glm-4.5-air

# 深度思考配置
# 是否启用深度思考模式（适用于支持思考的模型）
# 注意：启用后会增加响应时间和 Token 消耗，但能提高复杂任务的准确性
ENABLE_THINKING=false
# 思考模式类型：enabled（强制启用）/ disabled（禁用）/ auto（自动判断）
THINKING_TYPE=auto

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# 日志级别
LOG_LEVEL=INFO

# 日志数据库配置
LOG_DB_PATH=logs/app.db
ENABLE_LLM_LOGGING=true
ENABLE_NEO4J_LOGGING=true
LOG_RETENTION_DAYS=30
